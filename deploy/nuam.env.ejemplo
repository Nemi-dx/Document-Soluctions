# Copiar a /etc/nuam.env en el servidor (sudo cp deploy/nuam.env.ejemplo /etc/nuam.env) y completar.
# Formato de systemd: una variable por línea, sin comillas ni "export".
# Protegerlo:  sudo chown root:root /etc/nuam.env && sudo chmod 600 /etc/nuam.env
# (gunicorn lo lee a través de systemd, que corre como root, por eso no necesita permiso de lectura el usuario ubuntu)

DJANGO_DEBUG=0
# Generar una clave:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=PEGAR_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA

# IP elástica o dominio por el que entrarás, separados por coma (sin http://)
DJANGO_ALLOWED_HOSTS=54.0.0.1,nuam-tuNombre.duckdns.org
# Con dominio y certificado:  https://nuam-tuNombre.duckdns.org   |   solo demo por IP:  http://54.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://nuam-tuNombre.duckdns.org

# 1 = HTTPS obligatorio (cookies seguras, HSTS). 0 = SOLO demostración por http://IP, sin datos reales.
DJANGO_HTTPS=1
# nginx delante: la IP real del cliente llega en X-Real-IP (bitácora de auditoría)
DJANGO_PROXY_CONFIABLE=1

# Base de datos RDS
DB_HOST=nuam-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=nuam
DB_USER=admin
DB_PASSWORD=LA_CLAVE_QUE_PUSISTE_EN_RDS
# Conexión cifrada hacia RDS (ver docs/DESPLIEGUE_AWS.md, paso 6)
DB_SSL_CA=/etc/ssl/rds-global-bundle.pem

# Opcional: base no estructurada
# MONGO_URI=mongodb://...
